# ============================================================
#  G2A Marketing – környezeti változók sablon
#  Másold le `.env`-re, töltsd ki a valós értékeket.
#  A .env soha ne kerüljön commit-ba (a .gitignore tartalmazza).
# ============================================================

# ─── KÖTELEZŐ ──────────────────────────────────────────────

# TiDB Cloud Serverless connection string (MySQL-kompatibilis).
# Formátum: mysql://<user>.root:<password>@gateway01....tidbcloud.com:4000/test?ssl={"minVersion":"TLSv1.2"}
# A TiDB Cloud konzolban: Connect → General → connection string másolása.
DATABASE_URL=

# Cookie/JWT aláírás secret — production-ban legyen ≥32 karakter véletlen string.
# Generálás: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Dev szerver port (opcionális, default 3000)
PORT=3000

# ─── MANUS OAUTH (production admin loginhoz) ──────────────
# Manus Settings → App Registration lépésnél kapott értékek.
# Ha üres: /admin login crash-el — dev-ben a DEV_ADMIN_BYPASS-szal kerülhető meg.
VITE_APP_ID=
VITE_OAUTH_PORTAL_URL=
OAUTH_SERVER_URL=
# A Manus user openId-je, aki automatikusan admin szerepkört kap első belépéskor.
OWNER_OPEN_ID=

# ─── DEV-ONLY ─────────────────────────────────────────────
# Admin auth bypass — NE hagyd true-n production-ben!
# Csak akkor aktív, ha NODE_ENV=development + DEV_ADMIN_BYPASS=true.
DEV_ADMIN_BYPASS=false

# ─── OPCIONÁLIS INTEGRÁCIÓK ───────────────────────────────

# DeepL auto-fordítás (admin LocalizedField "HU → EN/ZH" gomb)
# Regisztráció: https://www.deepl.com/signup (ingyenes tier: 500k karakter/hó)
# Free kulcs ":fx" végződésű.
DEEPL_API_KEY=

# Cloudinary (case study + admin image hosting + auto WebP/AVIF + responsive)
# Regisztráció: https://cloudinary.com/users/register/free (25GB storage + 25GB bw/hó)
CLOUDINARY_URL=
VITE_CLOUDINARY_CLOUD_NAME=

# Resend (tranzakciós email — kapcsolatfelvétel + audit form értesítések)
# Regisztráció: https://resend.com/signup (3000 email/hó ingyen)
# DEV: 'onboarding@resend.dev' OK, PROD: hitelesített saját domain kell
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_NOTIFY_EMAIL=info@g2amarketing.hu

# Manus Forge AI (blog cikk / szöveggenerálás — nem kötelező)
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# OpenAI (admin AI asszisztens — blog draft, SEO meta auto-generálás)
# Regisztráció: https://platform.openai.com/api-keys
# Default model: gpt-4o-mini (~$0.15 / 1M input tokens, elegendő HU/EN/ZH tartalomhoz)
# Költség: ~5 HUF / blog draft, ~0.5 HUF / SEO meta. Felülírható: OPENAI_MODEL=gpt-4o
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Calendly (időpontfoglalás widget — audit-form thank-you + kapcsolat oldal)
# Regisztráció: https://calendly.com — készíts egy Event Type-ot (pl. "30 perces konzultáció")
# A teljes nyilvános URL kell, pl. https://calendly.com/g2amarketing/30min
# Ha üres, a widget elrejtődik (degraded gracefully)
VITE_CALENDLY_URL=

# Analytics — Plausible (preferred, privacy-friendly, no cookies = no GDPR banner needed)
# Setup: regisztrálj plausible.io-n, add hozzá a domain-t, majd:
VITE_PLAUSIBLE_DOMAIN=
# Vagy Umami self-hosted (ha sajat szervered van):
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
