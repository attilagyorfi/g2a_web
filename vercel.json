{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm run build:vercel",
  "outputDirectory": "dist/public",
  "framework": null,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api" },
    { "source": "/rss.xml", "destination": "/api" },
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/admin/:path*", "destination": "/index.html" },
    { "source": "/referenciak/:slug", "destination": "/index.html" },
    { "source": "/hirek/:slug", "destination": "/index.html" },
    { "source": "/en/:path*", "destination": "/index.html" },
    { "source": "/zh/:path*", "destination": "/index.html" },
    { "source": "/((?!api/).+)", "destination": "/index.html" }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 30
    }
  }
}
