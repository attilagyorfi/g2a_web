{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "vite build",
  "outputDirectory": "dist/public",
  "framework": null,
  "rewrites": [
    { "source": "/((?!api/).+)", "destination": "/index.html" }
  ],
  "functions": {
    "api/[[...path]].ts": {
      "maxDuration": 30,
      "memory": 1024
    }
  }
}
